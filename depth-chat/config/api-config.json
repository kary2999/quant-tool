{
  "api_base": "http://18.177.36.184/futures",
  "comment_api_base": "内网测试环境根路径；生产 host 见 hosts.production",
  "hosts": {
    "production": "https://contract.chishee.com",
    "comment": "depth-chat 内硬编码的生产 host，mock=1 时全部走 data/mock/*.json"
  },
  "endpoints": {
    "exchangeInfo": "/pub/exchangeInfo",
    "tickerList": "/pub/v2/tickerList",
    "depth": "/debug/depth",
    "klineDiff": "/debug/klineDiff",
    "depthGather": "/debug/depthGather",
    "exchangePrice": "/debug/exchangePrice",
    "priceHash": "/debug/priceHash"
  },
  "mock": {
    "enabled_by_query": "mock=1",
    "enabled_by_default": false,
    "data_dir": "data/mock",
    "manifest": "data/mock/mock.json",
    "files": {
      "exchangeInfo": "exchangeInfo.json",
      "tickerList": "tickerList.json",
      "depth": "depth.symbol-{symbol_id}.json",
      "depth_fallback": "depth.default.json",
      "klineDiff": "klineDiff.symbol-{symbol_id}.json",
      "klineDiff_fallback": "klineDiff.default.json",
      "depthGather": "depthGather.symbol-{symbol_id}.json",
      "depthGather_fallback": "depthGather.default.json",
      "exchangePrice": "exchangePrice.json",
      "priceHash": "priceHash.json"
    }
  },
  "notes": [
    "mock=1 时 contract.chishee.com 全部 7 个接口走本地 JSON，详见 data/mock/mock.json",
    "未命中 symbol 专用文件时使用 *.default.json",
    "币安深度等外网接口不在 mock 范围，离线时该区块为空属预期"
  ]
}
